{
  "name": "@pulseticker/mobile",
  "version": "0.0.1",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "test": "jest",
    "test:cov": "jest --coverage",
    "lint": "eslint .",
    "typegen": "EXPO_NO_TYPESCRIPT_SETUP=1 expo customize tsconfig.json",
    "typecheck": "pnpm run typegen && tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.spec.json"
  },
  "dependencies": {
    "@pulseticker/logging": "workspace:*",
    "@pulseticker/schemas": "workspace:*",
    "expo": "57.0.15",
    "expo-constants": "~57.0.13",
    "expo-linking": "~57.0.7",
    "expo-router": "~57.0.15",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.8",
    "react-native": "0.87.1",
    "react-native-safe-area-context": "~5.9.1",
    "react-native-screens": "~4.27.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.1.1",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.1",
    "jest": "^29.7.0",
    "jest-expo": "^57.0.4",
    "typescript": "~6.0.3"
  }
}
