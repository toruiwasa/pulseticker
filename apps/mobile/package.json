    "expo": "57.0.15",
    "expo-constants": "~57.0.13",
    "expo-linking": "~57.0.7",
    "expo-router": "~57.0.15",
    "expo-secure-store": "57.0.2",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
