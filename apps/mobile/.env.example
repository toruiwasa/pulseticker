# apps/mobile — copy to .env and fill in.
#
# Expo only exposes variables prefixed EXPO_PUBLIC_ to the app bundle. Every
# value here is therefore embedded in the shipped binary and is NOT a secret:
# put nothing here that is not already safe to hand to a client.
#
# In particular this is the Supabase *publishable* key (never the service_role
# key, which must never leave the server).
#
# ---------------------------------------------------------------------------
# How these reach the app: app.config.js copies them into `expo.extra`, and
# src/lib/config.ts reads them from there and THROWS at import if any of the
# three below is missing — naming it. A build without them fails on launch with
# that message rather than reporting `undefined` endpoints as network errors.
#
# This file covers LOCAL builds only. `.env` is gitignored and EAS does not
# upload it, so a cloud build (`eas build --profile ...`) sees only the `env`
# block in eas.json — today that is EXPO_PUBLIC_APP_ENV and nothing else.
#
# EXPO_PUBLIC_* values are inlined into the binary at BUILD time, so the three
# variables below must be supplied to EAS before the first cloud build or the
# app ships with `undefined` for its Supabase and API endpoints — it will fail
# at runtime, not at build time. Configuring that is tracked in issue #95,
# which also decides whether the values live in eas.json or on expo.dev.
# ---------------------------------------------------------------------------

# development | staging | production — drives log level, mirrors APP_ENV on
# web/api. Anything else (including unset) is treated as production, i.e. warn
# and error only.
EXPO_PUBLIC_APP_ENV=development

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# pulseticker NestJS API. In staging/production this is the Render URL
# (https://<service>.onrender.com).
#
# Locally it must be reachable *from the device running the app*, which is not
# the same host as your laptop — the baseline here is an EAS Development Build
# on a device or emulator, not Expo Go on localhost:
#
#   iOS simulator     http://localhost:3000     (shares the host network)
#   Android emulator  http://10.0.2.2:3000      (10.0.2.2 is the host loopback)
#   physical device   http://<your-LAN-IP>:3000 (same Wi-Fi; `ipconfig getifaddr en0`)
#
# localhost on a physical device resolves to the phone itself, so every request
# fails with a network error.
EXPO_PUBLIC_API_URL=http://localhost:3000
