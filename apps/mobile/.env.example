# apps/mobile — copy to .env and fill in.
#
# Expo only exposes variables prefixed EXPO_PUBLIC_ to the app bundle. Every
# value here is therefore embedded in the shipped binary and is NOT a secret:
# put nothing here that is not already safe to hand to a client.
#
# In particular this is the Supabase *publishable* key (never the service_role
# key, which must never leave the server).

# development | staging | production — drives log level, mirrors APP_ENV on web/api.
EXPO_PUBLIC_APP_ENV=development

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# pulseticker NestJS API (Render).
EXPO_PUBLIC_API_URL=http://localhost:3000
